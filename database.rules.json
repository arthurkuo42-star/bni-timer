{
  "rules": {
    ".read": false,
    ".write": false,

    "timer": {
      ".read": true,
      ".write": true,

      "state": {
        ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'running' || newData.val() === 'paused')"
      },
      "durationMs": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
      },
      "endTime": {
        ".validate": "newData.isNumber() && newData.val() > 0"
      },
      "pausedRemainingMs": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
      },
      "displayScale": {
        ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10"
      },
      "updatedAt": {
        ".validate": "newData.isNumber()"
      },

      "$other": {
        ".validate": false
      }
    }
  }
}
